# ==========================================
# E-COMMERCE PLATFORM
# Environment Variables Example
# ==========================================

# Application
APP_ENV=dev
APP_NAME=ecommerce-platform
LOG_LEVEL=info

# AWS
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=account_id

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce
DB_USER=app_user
DB_PASSWORD=change_me

# Redis / Cache
REDIS_HOST=localhost
REDIS_PORT=6379

# Services
PRODUCT_SERVICE_PORT=8081
CART_SERVICE_PORT=8082
CHECKOUT_SERVICE_PORT=8083
ORDER_SERVICE_PORT=8084
PAYMENT_SERVICE_PORT=8085

# AWS SQS
ORDER_QUEUE_URL=

# AWS Kinesis
KINESIS_STREAM_NAME=

# AWS Cognito
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Observability
OTEL_SERVICE_NAME=ecommerce-platform
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317